{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres",
    "InitializeOnStartup": true
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=zyft;Username=zyft;Password=zyft"
  },
  "Jwt": {
    "Issuer": "zyft-api",
    "Audience": "zyft-clients",
    "Secret": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Encryption": {
    "Key": ""
  },
  "Llm": {
    "Provider": "Ollama",
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen2.5:7b",
    "TimeoutSeconds": 120
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5080" ],
    "ExtensionIds": []
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AiPermitPerMinute": 60
  },
  "Web": {
    "RootPath": "../../web"
  },
  "Swagger": {
    "Enabled": true
  }
}
